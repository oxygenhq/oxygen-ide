{
  "name": "oxygenide",
  "productName": "Oxygen IDE",
  "version": "1.99.1",
  "description": "IDE for Oxygen automation framework.",
  "type": "commonjs",
  "scripts": {
    "build": "concurrently \"npm run build-main\" \"npm run build-renderer\"",
    "build-dll": "cross-env NODE_ENV=development node --openssl-legacy-provider --trace-warnings -r @babel/register ./node_modules/webpack/bin/webpack --config webpack.config.renderer.dev.dll.js",
    "build-main": "cross-env NODE_ENV=production node --openssl-legacy-provider --max-old-space-size=3072 --trace-warnings -r @babel/register ./node_modules/webpack/bin/webpack --config webpack.config.main.prod.js",
    "build-renderer": "cross-env NODE_ENV=production node --openssl-legacy-provider --max-old-space-size=3072 --trace-warnings -r @babel/register ./node_modules/webpack/bin/webpack --config webpack.config.renderer.prod.js",
    "dev": "cross-env START_HOT=1 node -r @babel/register ./internals/scripts/CheckPortInUse.js && cross-env START_HOT=1 npm run start-renderer-dev",
    "flow": "flow",
    "flow-typed": "rimraf flow-typed/npm && flow-typed update --ignoreDeps dev || (exit 0)",
    "lint": "cross-env NODE_ENV=development eslint '**/*.{js,jsx}' --quiet",
    "package": "npm install && cross-env RELEASE_BUILD=true npm run build && grunt",
    "postinstall": "npm run build-dll && cd app && npm i",
    "prestart": "npm run build",
    "start": "cross-env NODE_ENV=production electron -r @babel/register ./app/",
    "start-main-dev": "cross-env HOT=1 NODE_ENV=development electron ./wrap-main.dev.js",
    "start-renderer-dev": "cross-env NODE_ENV=development node --openssl-legacy-provider --trace-warnings -r @babel/register  ./node_modules/webpack-dev-server/bin/webpack-dev-server --config webpack.config.renderer.dev.js",
    "prepare": "husky install"
  },
  "browserslist": "electron 39.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxygenhq/oxygen-ide.git"
  },
  "author": {
    "name": "cloudbeat.io",
    "email": "ndimer@cloudbeat.io"
  },
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/oxygenhq/oxygen-ide/issues"
  },
  "homepage": "https://github.com/oxygenhq/oxygen-ide",
